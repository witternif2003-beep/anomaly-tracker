{
  "name": "lyra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.7"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43127",
    "prebuild": "npx --no-install tsx scripts/generate-static-site-data.ts",
    "build": "next build",
    "deploy:pages": "bash scripts/deploy-gh-pages.sh",
    "start": "next start --hostname 0.0.0.0 --port 43127",
    "lint": "bash scripts/eslint.sh",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "postinstall": "node scripts/relink-tsc.mjs",
    "verify": "bash scripts/verify-build.sh",
    "telemetry": "bash scripts/build-telemetry.sh",
    "toolchain": "bash scripts/install-toolchain.sh",
    "mcp:install": "bash scripts/install-mcp.sh",
    "mcp:audit": "bash scripts/audit-mcp.sh",
    "local-api": "tsx server/index.ts",
    "start:local": "tsx server/index.ts",
    "env:check": "bash scripts/check-env-placeholders.sh",
    "inventory:install": "bash scripts/install-p1-inventory.sh",
    "deps:verify": "bash scripts/verify-dependencies.sh",
    "install:all": "bash scripts/install-one-shot.sh",
    "install:all-safe": "bash scripts/install-all.sh",
    "scan:pipeline": "bash scripts/scan-pipeline.sh",
    "cf:dry-run": "bash scripts/wrangler-safe.sh deploy --dry-run --config workers/wrangler.toml",
    "cf:deploy": "bash scripts/wrangler-safe.sh deploy --config workers/wrangler.toml",
    "pipelines": "bash scripts/pipelines/p1-catalog-audit.sh && bash scripts/pipelines/skill-agent-roster.sh && bash scripts/pipelines/cloudflare-ci.sh && bash scripts/pipelines/cloudflare-p1-health.sh && bash scripts/pipelines/local-api-smoke.sh && bash scripts/pipelines/env-placeholders.sh && bash scripts/pipelines/no-github-actions.sh && bash scripts/pipelines/policy-guard.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.175.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.175.0",
    "@typescript/typescript6": "6.0.2",
    "eslint": "10.9.0",
    "eslint-config-next": "16.3.2",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0"
  }
}
