# Postgres connection string (Neon in production).
DATABASE_URL=
# Signs session cookies. Minimum 32 characters.
SESSION_SECRET=
# Operator sign-in passphrase. Minimum 12 characters.
OPERATOR_PASSPHRASE=
# Bearer token the scheduler presents to /api/cron/batch. Minimum 16 characters.
CRON_SECRET=
# Optional NVD API key; raises the request ceiling and removes the self-imposed delay.
NVD_API_KEY=
# Hours of record changes each batch reads. Default 24.
NVD_WINDOW_HOURS=24
# Minimum seconds between batches. Default 60.
BATCH_MIN_INTERVAL_SEC=60
# Minutes after which a page view starts a fresh batch
BATCH_STALE_MIN=30
