    { "id": "no-classified-flag", "group": "policy", "detail": "classified=false" },
    { "id": "fixture-clock-mode", "group": "clock", "detail": "mode includes fixture-clock" },
    { "id": "additive-only", "group": "policy", "detail": "pipeline never drops verified roster" },
    { "id": "scout-compatible", "group": "interop", "detail": "bot.active + self-heal fields readable" },
    { "id": "summary-candidate-count", "group": "interop", "detail": "summary mirrors candidateCount" },
    { "id": "discovery-pool-priorities", "group": "discovery", "detail": "discovery pool has P1 coverage" },
    { "id": "seed-p1-coverage", "group": "queue", "detail": "seed candidates include P1" },
    { "id": "normalized-names", "group": "integrity", "detail": "normalizedName present on queue rows" }
  ],
