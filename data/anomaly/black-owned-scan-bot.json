    { "id": "hardening-score-floor", "group": "hardening", "detail": "hardeningScore >= 95" },
    { "id": "hardening-gates-50", "group": "hardening", "detail": "hardening gate definitions >= 50" },
    { "id": "hardening-results-aligned", "group": "hardening", "detail": "results length == gate definitions" },
    { "id": "all-gates-ok", "group": "hardening", "detail": "every hardening result ok" },
    { "id": "integrity-hash-present", "group": "integrity", "detail": "integrityHash non-empty" },
    { "id": "queue-capacity", "group": "queue", "detail": "queueCapacity >= seed+pool" },
    { "id": "retry-policy", "group": "resilience", "detail": "retryPolicy.maxAttempts >= 3" },
    { "id": "backoff-policy", "group": "resilience", "detail": "retryPolicy.backoffMs >= 250" },
    { "id": "circuit-breaker", "group": "resilience", "detail": "circuitBreaker configured" },
    { "id": "idempotent-admit", "group": "queue", "detail": "idempotentAdmit=true" },
    { "id": "dead-letter-bucket", "group": "resilience", "detail": "deadLetter enabled" },
    { "id": "observability-metrics", "group": "observability", "detail": "metrics counters present" },
    { "id": "may-forensic-bind", "group": "pipeline", "detail": "may-forensic-menu-bind in actions" },
