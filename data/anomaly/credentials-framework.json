{
  "title": "Credentials & security framework (research note §5)",
  "classified": false,
  "governmentProgram": false,
  "note": "Every listed placeholder resolves via a free public tool when no paid secret is injected (see data/anomaly/free-api-resolutions.json). .env.example stays empty. HashiCorp Vault is not deployed. CJIS/NCIC live queries stay refused; FBI CDE is the free typology substitute.",
  "envFiles": {
    "example": ".env.example",
    "local": ".env.local",
    "gitignored": [".env", ".env.local", ".env*.local"],
    "freeResolutions": "data/anomaly/free-api-resolutions.json"
  },
  "groups": [
    {
      "id": "core",
      "title": "Core",
      "variables": [
        {
          "name": "DATABASE_URI",
          "purpose": "Local SQLite free URI (Postgres MCP optional)",
          "alias": ["DATABASE_URL", "ORACLE_CONNECTION_STRING"],
          "status": "free-resolved"
        }
      ]
    },
    {
      "id": "mcp",
      "title": "MCP servers",
      "variables": [
        { "name": "AMPLITUDE_API_KEY", "purpose": "Amplitude MCP" },
        { "name": "AWS_ACCESS_KEY_ID", "purpose": "CloudWatch MCP" },
        { "name": "AWS_SECRET_ACCESS_KEY", "purpose": "CloudWatch MCP" },
        { "name": "FIGMA_API_KEY", "purpose": "Figma MCP", "alias": ["FIGMA_ACCESS_TOKEN"] },
        { "name": "LINEAR_API_KEY", "purpose": "Linear remote MCP (optional)" },
        { "name": "STRIPE_SECRET_KEY", "purpose": "Stripe MCP" },
        { "name": "CLOUDFLARE_API_TOKEN", "purpose": "Cloudflare MCP / wrangler dry-run" },
        { "name": "CLOUDFLARE_ACCOUNT_ID", "purpose": "Cloudflare MCP / wrangler dry-run" },
        {
          "name": "FIRECRAWL_API_KEY",
          "purpose": "Jina Reader free path (/v1/free/firecrawl)",
          "status": "free-resolved"
        },
        { "name": "SENTRY_AUTH_TOKEN", "purpose": "Sentry MCP" },
        { "name": "SLACK_BOT_TOKEN", "purpose": "Slack MCP (company workspace only)" },
        {
          "name": "CONTEXT7_API_KEY",
          "purpose": "npms.io + jsDelivr free docs (/v1/free/context7)",
          "status": "free-resolved"
        }
      ]
    },
    {
      "id": "legal",
      "title": "Legal research",
      "variables": [
        {
          "name": "OPENLAWS_API_KEY",
          "purpose": "CourtListener + GovInfo free stack",
          "status": "free-resolved"
        },
        {
          "name": "WESTLAW_USERNAME",
          "purpose": "CourtListener free substitute (no Westlaw contract)",
          "status": "free-resolved"
        },
        {
          "name": "WESTLAW_PASSWORD",
          "purpose": "Glossary + FRE free substitute",
          "status": "free-resolved"
        },
        {
          "name": "LEXISNEXIS_API_KEY",
          "purpose": "CourtListener + Congress.gov free stack",
          "status": "free-resolved"
        },
        {
          "name": "PACER_USERNAME",
          "purpose": "CourtListener RECAP free path (no CM/ECF)",
          "status": "free-resolved"
        },
        {
          "name": "PACER_PASSWORD",
          "purpose": "CourtListener RECAP free path (no CM/ECF)",
          "status": "free-resolved"
        },
        {
          "name": "FINRA_API_KEY",
          "purpose": "FINRA public weeklySummary + EDGAR",
          "status": "free-resolved"
        },
        {
          "name": "USPTO_API_KEY",
          "purpose": "Google Patents XHR free path",
          "status": "free-resolved"
        }
      ]
    },
    {
      "id": "cjis",
      "title": "FBI / law enforcement",
      "variables": [
        {
          "name": "CJIS_ORI",
          "purpose": "FBI CDE typology only; live CJIS refused",
          "status": "free-resolved"
        },
        {
          "name": "CJIS_AGENCY_ID",
          "purpose": "FBI CDE typology only; live CJIS refused",
          "status": "free-resolved"
        },
        {
          "name": "NCIC_ORI",
          "purpose": "FBI CDE typology only; live NCIC refused",
          "status": "free-resolved"
        },
        {
          "name": "NCIC_MNEMONIC",
          "purpose": "Fixture only; live NCIC refused",
          "status": "free-resolved"
        },
        {
          "name": "FBI_UCR_AGENCY_ID",
          "purpose": "Public CDE ORI CA0140000",
          "status": "free-resolved"
        }
      ],
      "liveQueries": false,
      "note": "Not a CJIS-certified interface. POST /v1/cjis/search always 403. GET /v1/free/fbi-cde is the free typology tool."
    }
  ],
  "vault": {
    "proposed": "vault.hcl with file storage + awskms seal",
    "exampleFile": "vault.hcl.example",
    "status": "wont-deploy",
    "shipped": "server/policy.ts + free API resolutions + CJIS always-403 + wrangler dry-run only",
    "note": "Do not start HashiCorp Vault, OPA, or Istio from this studio. Secrets belong in Cloud Agent Secrets or gitignored .env.local."
  },
  "commands": [
    "npm run env:check",
    "curl -fsS http://127.0.0.1:4040/v1/env",
    "curl -fsS http://127.0.0.1:4040/v1/env/free",
    "curl -fsS http://127.0.0.1:4040/v1/policy",
    "curl -fsS http://127.0.0.1:4040/v1/compliance/cjis",
    "curl -fsS 'http://127.0.0.1:4040/v1/free/fbi-cde?state=CA'"
  ],
  "wontDo": [
    {
      "id": "commit-secrets",
      "title": "Commit real secret values",
      "reason": ".env.example stays empty. .env.local is gitignored. free: sentinels are not secrets."
    },
    {
      "id": "hashicorp-vault-live",
      "title": "Deploy HashiCorp Vault from this app",
      "reason": "vault.hcl.example is documentation only."
    },
    {
      "id": "cjis-live",
      "title": "Live CJIS/NCIC queries",
      "reason": "Free FBI CDE typology only; refuse live criminal-justice traffic."
    }
  ]
}
