{
  "title": "Credentials & security framework (research note §5)",
  "classified": false,
  "governmentProgram": false,
  "note": "Placeholders live in .env.example and Cloud Agent Secrets. Values must never be committed. HashiCorp Vault is not deployed — policy + empty placeholders are the shipped substitute. CJIS/NCIC remain applicable placeholders with live queries refused.",
  "envFiles": {
    "example": ".env.example",
    "local": ".env.local",
    "gitignored": [".env", ".env.local", ".env*.local"]
  },
  "groups": [
    {
      "id": "core",
      "title": "Core",
      "variables": [
        { "name": "DATABASE_URI", "purpose": "Postgres MCP / company DB", "alias": ["DATABASE_URL", "ORACLE_CONNECTION_STRING"] }
      ]
    },
    {
      "id": "mcp",
      "title": "MCP servers",
      "variables": [
        { "name": "AMPLITUDE_API_KEY", "purpose": "Amplitude MCP" },
        { "name": "AWS_ACCESS_KEY_ID", "purpose": "CloudWatch MCP" },
        { "name": "AWS_SECRET_ACCESS_KEY", "purpose": "CloudWatch MCP" },
        { "name": "FIGMA_API_KEY", "purpose": "Figma MCP", "alias": ["FIGMA_ACCESS_TOKEN"] },
        { "name": "LINEAR_API_KEY", "purpose": "Linear remote MCP (optional)" },
        { "name": "STRIPE_SECRET_KEY", "purpose": "Stripe MCP" },
        { "name": "CLOUDFLARE_API_TOKEN", "purpose": "Cloudflare MCP / wrangler dry-run" },
        { "name": "CLOUDFLARE_ACCOUNT_ID", "purpose": "Cloudflare MCP / wrangler dry-run" },
        { "name": "FIRECRAWL_API_KEY", "purpose": "Firecrawl MCP" },
        { "name": "SENTRY_AUTH_TOKEN", "purpose": "Sentry MCP" },
        { "name": "SLACK_BOT_TOKEN", "purpose": "Slack MCP (company workspace only)" },
        { "name": "CONTEXT7_API_KEY", "purpose": "Context7 MCP" }
      ]
    },
    {
      "id": "legal",
      "title": "Legal research",
      "variables": [
        { "name": "OPENLAWS_API_KEY", "purpose": "OpenLaws REST stub", "status": "optional" },
        { "name": "WESTLAW_USERNAME", "purpose": "Westlaw contract login", "status": "contract-required" },
        { "name": "WESTLAW_PASSWORD", "purpose": "Westlaw contract login", "status": "contract-required" },
        { "name": "LEXISNEXIS_API_KEY", "purpose": "LexisNexis portal", "status": "contract-required" },
        { "name": "PACER_USERNAME", "purpose": "PACER stub (no CM/ECF session)", "status": "optional" },
        { "name": "PACER_PASSWORD", "purpose": "PACER stub (no CM/ECF session)", "status": "optional" },
        { "name": "FINRA_API_KEY", "purpose": "FINRA REST stub", "status": "optional" }
      ]
    },
    {
      "id": "cjis",
      "title": "FBI / law enforcement",
      "variables": [
        { "name": "CJIS_ORI", "purpose": "Applicable placeholder only", "status": "placeholder" },
        { "name": "CJIS_AGENCY_ID", "purpose": "Applicable placeholder only", "status": "placeholder" },
        { "name": "NCIC_ORI", "purpose": "Applicable placeholder only", "status": "placeholder" },
        { "name": "NCIC_MNEMONIC", "purpose": "Applicable placeholder only", "status": "placeholder" },
        { "name": "FBI_UCR_AGENCY_ID", "purpose": "Public CDE identifiers only", "status": "placeholder" }
      ],
      "liveQueries": false,
      "note": "Not a CJIS-certified interface. POST /v1/cjis/search always 403."
    }
  ],
  "vault": {
    "proposed": "vault.hcl with file storage + awskms seal",
    "exampleFile": "vault.hcl.example",
    "status": "wont-deploy",
    "shipped": "server/policy.ts + .env placeholders + CJIS always-403 + wrangler dry-run only",
    "note": "Do not start HashiCorp Vault, OPA, or Istio from this studio. Secrets belong in Cloud Agent Secrets or gitignored .env.local."
  },
  "commands": [
    "npm run env:check",
    "curl -fsS http://127.0.0.1:4040/v1/env",
    "curl -fsS http://127.0.0.1:4040/v1/policy",
    "curl -fsS http://127.0.0.1:4040/v1/compliance/cjis"
  ],
  "wontDo": [
    {
      "id": "commit-secrets",
      "title": "Commit real secret values",
      "reason": ".env.example stays empty. .env.local is gitignored."
    },
    {
      "id": "hashicorp-vault-live",
      "title": "Deploy HashiCorp Vault from this app",
      "reason": "vault.hcl.example is documentation only."
    },
    {
      "id": "cjis-live",
      "title": "Live CJIS/NCIC queries",
      "reason": "Placeholders only; refuse live criminal-justice traffic."
    }
  ]
}
