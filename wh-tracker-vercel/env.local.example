# Copy to .env.local (git-ignored) or set these as Vercel project environment variables.

# Required for every POST (writes). Generate with: openssl rand -hex 32
API_KEY=

# Neon Postgres connection string. Without it, state is per-instance and ephemeral.
DATABASE_URL=

# AlienVault OTX key; /api/threat-intel returns 503 without it.
OTX_API_KEY=
# Default indicator list when ?indicators= is not supplied.
OTX_INDICATORS=

# Comma-separated CORS allowlist for cross-site reads; "*" opens the API to any site.
# Same-origin requests from the deployed viewer never need this.
ALLOWED_ORIGINS=

# Optional overrides
# AGENCY_CODE=011
# USASPENDING_URL=https://api.usaspending.gov
# OTX_URL=https://otx.alienvault.com
# SSE_POLL_MS=2000
# SSE_MAX_DURATION_S=50
