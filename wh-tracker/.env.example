# Copy to .env and fill in. Never commit the real .env (*.env is gitignored).

# Public API key for FEC open data (https://api.open.fec.gov/developers/)
FEC_API_KEY=DEMO_KEY
# AlienVault OTX API key (https://otx.alienvault.com/api)
OTX_API_KEY=

# Shared secret required on all mutating /api routes (X-API-Key header).
# Leave empty here; generate per deployment: openssl rand -hex 32
API_KEY=

# Grafana admin password (generate per deployment: openssl rand -base64 24)
GRAFANA_PASSWORD=

# TAXII 2.1 collection to publish STIX bundles to (optional; skipped when unset)
TAXII_URL=
TAXII_USER=
TAXII_PASS=

# Ports
PORT=3000
PDF_PORT=4005

# Scheduler intervals (minutes)
FEC_INTERVAL_MINUTES=360
TREASURY_INTERVAL_MINUTES=720
OTX_INTERVAL_MINUTES=180
