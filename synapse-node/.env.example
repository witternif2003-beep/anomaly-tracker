# Postgres (Neon on Vercel; local: postgres://synapse:synapse@127.0.0.1:5432/synapse_node)
DATABASE_URL=
# DeepSeek (https://api-docs.deepseek.com). Without a key the engine stays offline; no placeholder batches are generated.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRIES=3
BATCH_INTERVAL_SEC=60
DAILY_BATCH_CAP=500
# Operator auth (passphrase >= 12 chars, session secret >= 32 chars); CRON_SECRET >= 16 chars for /api/cron/tick
OPERATOR_PASSPHRASE=
SESSION_SECRET=
CRON_SECRET=
# docker-compose only
POSTGRES_PASSWORD=
OPERATOR_TOKEN=
