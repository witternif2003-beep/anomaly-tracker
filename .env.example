# Copy to gitignored .env.local for real values. Never commit secrets.
# Cloud Agents: inject these in the environment Secrets tab, not in git.
# All assignments below are empty placeholders.

# 7. ENVIRONMENT VARIABLES (placeholders)
CLOUDFLARE_API_TOKEN=         # required for Cloudflare MCP
CLOUDFLARE_ACCOUNT_ID=        # required
DATABASE_URI=                 # for Postgres MCP Pro
FIRECRAWL_API_KEY=            # for Firecrawl
CONTEXT7_API_KEY=             # for Context7
OPENLAWS_API_KEY=             # for OpenLaws
WESTLAW_USERNAME=             # Thomson Reuters
WESTLAW_PASSWORD=
LEXISNEXIS_API_KEY=           # LexisNexis dev portal

# CJIS / NCIC / federal (applicable placeholders — never live queries from this app)
CJIS_ORI=
CJIS_AGENCY_ID=
NCIC_ORI=
NCIC_MNEMONIC=
FBI_UCR_AGENCY_ID=

# Closest aliases the installed packages also read (still empty)
DATABASE_URL=                 # mcp-postgres / libpq equivalent of DATABASE_URI
WESTLAW_CLIENT_ID=            # Thomson Reuters API (OAuth) if username/password unused
WESTLAW_CLIENT_SECRET=
WESTLAW_API_KEY=
WESTLAW_ENDPOINT=
LEXISNEXIS_CLIENT_ID=
LEXISNEXIS_CLIENT_SECRET=
LEXISNEXIS_ENDPOINT=
OPENLAWS_ENDPOINT=

