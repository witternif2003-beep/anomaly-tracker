# Copy to .env.local in this VM only. Never commit real values.
# Cloud Agents: add these in the environment Secrets tab, not in git.
# MCP servers in .cursor/mcp.json are configured but not authenticated.

# Optional Sinch Conversation MCP (not required for Lyra)
# CONVERSATION_PROJECT_ID=
# CONVERSATION_KEY_ID=
# CONVERSATION_KEY_SECRET=
# CONVERSATION_REGION=
# CONVERSATION_APP_ID=

# Amplitude (amplitude-mcp; @amplitude/mcp is not on npm)
# AMPLITUDE_API_KEY=
# AMPLITUDE_SECRET_KEY=

# AWS CloudWatch (@teolin/mcp-cloudwatch-logs; @aws/mcp is not on npm)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Figma (figma-developer-mcp; @figma/mcp is not on npm)
# FIGMA_API_KEY=

# Stripe
# STRIPE_SECRET_KEY=

# Cloudflare Code Mode (mcp-remote to mcp.cloudflare.com; @cloudflare/mcp is not on npm)
# CLOUDFLARE_API_TOKEN=

# Firecrawl
# FIRECRAWL_API_KEY=

# Postgres MCP Pro (PyPI postgres-mcp; @postgres/mcp-pro is not on npm)
# DATABASE_URI=

# Sentry
# SENTRY_AUTH_TOKEN=

# Slack (@chinchillaenterprises/mcp-slack; @slack/mcp is not on npm)
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=

# Context7 (@upstash/context7-mcp; context7-mcp is not on npm)
# CONTEXT7_API_KEY=
